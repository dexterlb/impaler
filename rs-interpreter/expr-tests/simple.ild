(tests
  (case "adds"
    ((expr (+ 2 3))
     (expected 5)))
  (case "subtracts"
    ((expr (- 10 4))
     (expected 6)))
  (case "multiplies"
    ((expr (* 2 3))
     (expected 6)))
  (case "less-than-true"
    ((expr (< 1 2))
     (expected #t)))
  (case "less-than-false"
    ((expr (< 2 1))
     (expected #f)))
  (case "greater-than"
    ((expr (> 2 1))
     (expected #t)))
  (case "equal-true"
    ((expr (= 2 2))
     (expected #t)))
  (case "equal-false"
    ((expr (= 2 3))
     (expected #f)))
  (case "nested-arithmetic"
    ((expr (+ (+ 1 1) 3))
     (expected 5)))
  (case "nested-predicate"
    ((expr (< (- 5 4) 3))
     (expected #t))))
