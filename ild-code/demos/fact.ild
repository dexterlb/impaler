(module
  (doc "this module calculates factorials :)")
  (exports main)
  (imports
    (host (macroexpand <= * +))
    ("core/prelude.ild" (lambda if))
    ("core/module-utils.ild" (fn)))
  (defs
    (!fn main () (fact 5))

    (!fn fact (x)
      (!if (<= x 0)
        1
        (* x (fact (+ x -1)))))))
