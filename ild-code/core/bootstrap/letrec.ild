(!(eval (free-vars) (read-source "core/bootstrap/let.ild")) (
  (lambda (eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild")))
  (if (eval (free-vars) (read-source "core/bootstrap/if.ild")))
  (let (eval (free-vars) (read-source "core/bootstrap/let.ild")))
  (map (eval (free-vars) (read-source "core/bootstrap/map.ild")))
  (poly-Y (eval (free-vars) (read-source "core/bootstrap/poly-y.ild"))))

  (!let (
    (expand-lambda (!lambda (args body) (cons macroexpand (cons lambda (cons args (cons body '()))))))
    (list (!lambda args args))
    (cadr (!lambda (p) (car (cdr p)))))

    ; definition of "letrec"
    (!lambda (defs body)
      (!let
        ((args (map car defs)))

          (!let (
            (arg-bodies
              (map
                (!lambda (def)
                  (expand-lambda args (cadr def)))
                defs)))

            (list
              apply
              (expand-lambda args body)
              (cons poly-Y arg-bodies)))))))
