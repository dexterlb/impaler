(mk-lambda
  (free-vars)       ; this can be replaced with a closure that has just cons, mk-lambda, quote and free-vars
  (quote (arg-names body))
  (quote
    (cons mk-lambda
      (cons (cons (quote quote) (cons (free-vars) (quote ())))  ; quoted closure (result of free-vars)
        (cons (cons (quote quote) (cons arg-names (quote ())))  ; quoted arg-names
          (cons (cons (quote quote) (cons body (quote ())))     ; quoted body
            (quote ())))))))
