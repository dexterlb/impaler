((!(eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild")) (lambda if)
  ; polyvariate Y combinator (operates on a list of functions instead of a single function)
  ; if poly-fix is already available, use it
  ; TODO: more civilised way to check that this exists
  (!if (func? poly-fix)
    poly-fix
    ((!lambda (map)
      (!lambda l
        ((!lambda (x) (x x))
          (!lambda (p)
            (map (!lambda (li) (!lambda args (apply (apply li (p p)) args))) l)))))

      ; definition of map
      (eval (free-vars) (read-source "core/bootstrap/map.ild")))))

  ; definition of lambda
  (eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild"))

  ; definition of if
  (eval (free-vars) (read-source "core/bootstrap/if.ild")))
