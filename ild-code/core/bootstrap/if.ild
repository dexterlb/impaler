((!(eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild")) (lambda)
  ((!lambda (list)

    ; (if cond foo bar) should expand to
    ; (((bool-to-k cond) (!lambda () foo) (!lambda () bar)))
    (!lambda (cond t f)     ; read this definition bottom to top
      (list                          ; force the result
        (list                        ; eval the branch selector getting one of the delayed vals
          (list bool-to-k cond)      ; obtain branch selector from cond
          (lambda '() t)      ; delay t branch
          (lambda '() f)))))  ; delay f branch


    ; definition of list
    (!lambda args args)))

  ; definition of lambda
  (eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild")))
