((!(eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild")) (lambda if)
  (!if (func? poly-fix)
    ; if poly-fix is available, define Y through it
    (!lambda (f)
      (car (poly-fix f)))

    ; otherwise, define Y without relying on recursion
    (!lambda (f)
      ((!lambda (x)
        (f (!lambda args (apply (x x) args))))
        (!lambda (x)
          (f (!lambda args (apply (x x) args))))))))

  ; definition of lambda
  (eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild"))

  ; definition of if
  (eval (free-vars) (read-source "core/bootstrap/if.ild")))
