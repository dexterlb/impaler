((!(eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild")) (lambda if)
  ((eval (free-vars) (read-source "core/bootstrap/define-y.ild"))
    (!lambda (map)
      (!lambda (f l)
        (!if (null? l)
          l
          (!if (pair? l)
            (cons (f (car l)) (map f (cdr l)))
            (make-fail (cons 'not-a-list (cons l '())))))))))

  ; definition of lambda
  (eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild"))

  ; definition of if
  (eval (free-vars) (read-source "core/bootstrap/define-if.ild")))
