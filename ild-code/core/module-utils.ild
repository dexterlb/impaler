(module
  (doc "some helpers for working with modules")
  (exports fn)
  (imports
    (builtin (car cdr cons lambda macroexpand quote bool-to-k))
    ("core/prelude.ild" (expand-lambda list))
  )
  (defs
    '(fn (!lambda (name arg-spec body)
      (list quote
        (list name (expand-lambda arg-spec body)))))))
