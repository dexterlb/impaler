(case "mk-lambda"
  (expr (
    (mk-lambda
      (cons (cons '+ +) '((c . 42) (d . 3)))
      '(a b)
      '(+ a b c d))
    1 2))
  (expected 48))

(case "eval"
  (expr
    (eval (cons (cons '+ +) '()) '(+ 40 2)))
  (expected 42))

(case "read-source"
  (expr (read-source "fourtytwo.ild"))
  (expected 42))

(case "free-vars"
  (expr (eval '((foo . 42)) (cons free-vars '())))
  (expected ((foo . 42))))

(case "lambda-macro"
  (expr
    (eval
      (cons (cons 'lambda (eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild")))
        (cons '(c . 42) (free-vars)))
      '((eval (free-vars)
        (lambda
          '(a b)
          '(+ a b c)))
        1 2)))
  (expected 45))

(case "macroexpand-and-lambda-macro"
  (expr (
    (macroexpand
      (eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild"))  ; lambda
      (a b)
      (+ a b 42))

    1 2))
  (expected 45))

(case "macroexpand-syntax"
  (expr (
    (!(eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild"))  ; lambda
      (a b)
      (+ a b 42))

    1 2))
  (expected 45))

(case "can-define-and-then-use-lambda"
  (expr (
    (!(eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild")) (lambda)

      ((!lambda (a b) (+ a b 42)) 1 2))

    (eval (free-vars) (read-source "core/bootstrap/lambda-macro.ild"))))
  (expected 45))
